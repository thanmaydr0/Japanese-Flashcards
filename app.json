{
  "expo": {
    "name": "Japy",
    "slug": "kana-path",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "kanapath",
    "icon": "./assets/kana-path-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.thanmaydr1.kanapath",
      "versionCode": 8,
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/kana-path-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#16463E",
        "foregroundImage": "./assets/kana-path-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0D5247",
          "defaultChannel": "study-reminders"
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-quick-actions/icon/plugin",
        {
          "afternoon": {
            "image": "./assets/kana-path-afternoon-icon.png"
          },
          "evening": {
            "image": "./assets/kana-path-evening-icon.png"
          },
          "night": {
            "image": "./assets/kana-path-night-icon.png"
          },
          "streak": {
            "image": "./assets/kana-path-streak-icon.png"
          },
          "legendary": {
            "image": "./assets/kana-path-legendary-icon.png"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/kana-path-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d474e4bd-dcfe-4df9-a1b3-7bdf541d9510"
      }
    },
    "owner": "thanmaydr1"
  }
}
